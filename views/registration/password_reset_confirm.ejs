<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SGR La Serena - Nueva Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm border-0" style="width: 100%; max-width: 420px;">
        <div class="card-header bg-primary text-white text-center py-3">
            <h5 class="mb-0 fw-bold">Nueva Contraseña</h5>
            <small>Define tu nueva clave de acceso</small>
        </div>
        <div class="card-body p-4">
            <% if (form && form.errors && form.errors.length > 0) { %>
                <div class="alert alert-danger small mb-3">
                    <% form.errors.forEach(err => { %>
                        <div><%= err %></div>
                    <% }) %>
                </div>
            <% } %>

            <form method="post" action="/password-reset/confirm/">
                <div class="mb-3">
                    <label for="id_new_password" class="form-label fw-semibold">Nueva contraseña</label>
                    <input type="password" name="new_password" id="id_new_password" class="form-control" placeholder="Mínimo 8 caracteres" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="id_confirm_password" class="form-label fw-semibold">Confirmar nueva contraseña</label>
                    <input type="password" name="confirm_password" id="id_confirm_password" class="form-control" placeholder="Repita la contraseña" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold">Cambiar Contraseña</button>
            </form>
        </div>
    </div>
</body>
</html>
