<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGR La Serena - Iniciar Sesión</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-sm border-0" style="width: 100%; max-width: 400px;">
        <div class="card-header bg-primary text-white text-center py-3">
            <h5 class="mb-0 fw-bold">SGR La Serena</h5>
            <small>Ingreso al Sistema de Gestión</small>
        </div>
        <div class="card-body p-4">
            
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(message => { %>
                    <div class="alert alert-<%= message.tags === 'error' ? 'danger' : message.tags %> p-2 mb-3 small text-center">
                        <%= message.text %>
                    </div>
                <% }) %>
            <% } %>

            <% if (form && form.errors) { %>
                <div class="alert alert-danger text-center p-2 mb-3 small">
                    Usuario o contraseña incorrectos. Intente nuevamente.
                </div>
            <% } %>

            <!-- Demo helper card -->
            <div class="alert alert-info p-2 mb-3 small">
                <strong>Cuentas de prueba:</strong><br>
                &bull; <code>admin</code> / <code>admin1234</code> (Administrador)<br>
                &bull; <code>funcionario1</code> / <code>user1234</code> (Funcionario Centro)<br>
                &bull; <code>delegado_companias</code> / <code>laserena2026</code> (Delegado)
            </div>

            <form method="post" action="/login">
                <input type="hidden" name="next" value="<%= next %>">
                <div class="mb-3">
                    <label for="id_username" class="form-label fw-semibold">Usuario</label>
                    <input type="text" name="username" class="form-control" id="id_username" placeholder="admin" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="id_password" class="form-label fw-semibold">Contraseña</label>
                    <input type="password" name="password" class="form-control" id="id_password" placeholder="admin1234" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2">Ingresar</button>
            </form>

            <div class="text-center mt-3 d-flex justify-content-between">
                <a href="/password-reset/" class="text-primary small text-decoration-none">¿Olvidaste tu contraseña?</a>
                <a href="/wireframe-front" class="text-muted small text-decoration-none">← Sitio público</a>
            </div>

        </div>
    </div>

</body>
</html>
