<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGR La Serena - Recuperar Contraseña</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm border-0" style="width: 100%; max-width: 420px;">
        <div class="card-header bg-primary text-white text-center py-3">
            <h5 class="mb-0 fw-bold">Recuperar Contraseña</h5>
            <small>Código de Verificación Temporal</small>
        </div>
        <div class="card-body p-4">
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(message => { %>
                    <div class="alert alert-<%= message.tags === 'error' ? 'danger' : message.tags %> small mb-3"><%= message.text %></div>
                <% }) %>
            <% } %>

            <div class="alert alert-light border small mb-3">
                <strong>Correos registrados de prueba:</strong><br>
                &bull; <code>admin@laserena.cl</code><br>
                &bull; <code>funcionario@laserena.cl</code><br>
                &bull; <code>delegado@laserena.cl</code>
            </div>

            <form method="post" action="/password-reset/">
                <div class="mb-3">
                    <label for="id_email" class="form-label fw-semibold">Correo electrónico registrado</label>
                    <input type="email" name="email" id="id_email" class="form-control" placeholder="admin@laserena.cl" value="<%= form.email || '' %>" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold">Enviar Código</button>
            </form>
            <div class="text-center mt-3">
                <a href="/login" class="text-muted small text-decoration-none">← Volver al Login</a>
            </div>
        </div>
    </div>
</body>
</html>
