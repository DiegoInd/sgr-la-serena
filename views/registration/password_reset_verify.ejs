<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SGR La Serena - Verificar Código</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow-sm border-0" style="width: 100%; max-width: 440px;">
        <div class="card-header bg-primary text-white text-center py-3">
            <h5 class="mb-0 fw-bold">Ingresa el Código</h5>
            <small>Código de Seguridad de 6 Dígitos</small>
        </div>
        <div class="card-body p-4">
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(message => { %>
                    <div class="alert alert-<%= message.tags === 'error' ? 'danger' : message.tags %> small mb-3"><%= message.text %></div>
                <% }) %>
            <% } %>

            <!-- Live Timer Indicator -->
            <div class="alert alert-light border text-center py-2 mb-3">
                <span class="small text-muted d-block">Tiempo restante de validez:</span>
                <span id="countdownDisplay" class="fw-bold fs-4 text-primary">02:00</span>
                <div class="progress mt-1" style="height: 4px;">
                    <div id="countdownBar" class="progress-bar bg-primary" role="progressbar" style="width: 100%;"></div>
                </div>
            </div>

            <% if (demoCode) { %>
                <div class="d-flex justify-content-between align-items-center p-2 mb-3 bg-light border rounded small">
                    <span>Código demo generado: <strong class="text-primary font-monospace fs-6"><%= demoCode %></strong></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="document.getElementById('id_code').value='<%= demoCode %>'">Autocompletar</button>
                </div>
            <% } %>

            <form method="post" action="/password-reset/verify/">
                <div class="mb-3">
                    <label for="id_code" class="form-label fw-semibold">Código de verificación (6 dígitos):</label>
                    <input type="text" name="code" id="id_code" class="form-control text-center fs-3 fw-bold font-monospace letter-spacing" placeholder="123456" maxlength="6" minlength="6" value="<%= form.code || '' %>" required autofocus>
                    <small class="text-muted d-block mt-2">Máximo 5 intentos fallidos antes del bloqueo de seguridad.</small>
                </div>
                <button type="submit" id="verifyBtn" class="btn btn-primary w-100 fw-bold py-2">Verificar Código</button>
            </form>
            <div class="text-center mt-3">
                <a href="/password-reset/" class="text-muted small text-decoration-none">← Reenviar nuevo código</a>
            </div>
        </div>
    </div>

    <script>
        let timeLeft = <%= secondsRemaining %>;
        const totalDuration = 120;
        const display = document.getElementById('countdownDisplay');
        const bar = document.getElementById('countdownBar');
        const btn = document.getElementById('verifyBtn');

        function updateTimer() {
            if (timeLeft <= 0) {
                display.textContent = '00:00 (Expirado)';
                display.classList.remove('text-primary');
                display.classList.add('text-danger');
                bar.style.width = '0%';
                bar.className = 'progress-bar bg-danger';
                return;
            }

            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            display.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            const pct = (timeLeft / totalDuration) * 100;
            bar.style.width = pct + '%';

            if (timeLeft < 30) {
                display.classList.add('text-danger');
                bar.className = 'progress-bar bg-danger';
            } else if (timeLeft < 60) {
                display.classList.add('text-warning');
                bar.className = 'progress-bar bg-warning';
            }

            timeLeft--;
            setTimeout(updateTimer, 1000);
        }

        updateTimer();
    </script>
</body>
</html>
