<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGR La Serena - Portal Ciudadano de Transparencia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .hero-banner {
            background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
            color: white;
            border-radius: 1rem;
            padding: 3rem 2rem;
        }
        .stat-card {
            border-radius: 0.75rem;
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
            transition: transform 0.2s ease;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="/wireframe-front">
                <span class="fs-4 me-2">🏛️</span>
                <span>Municipalidad de La Serena <small class="fw-normal text-white-50 d-block d-sm-inline ms-sm-2">| Portal de Transparencia SGR</small></span>
            </a>
            <div class="d-flex align-items-center">
                <a href="/catalogo-servicios" class="btn btn-sm btn-outline-light me-2">Catálogo de Servicios</a>
                <a href="/login" class="btn btn-sm btn-light text-primary fw-bold px-3">Acceso Funcionarios</a>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <!-- Hero Section -->
        <div class="hero-banner mb-4 shadow">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-light text-primary fw-bold mb-2 px-3 py-1 text-uppercase">Portal Ciudadano Oficial</span>
                    <h1 class="display-6 fw-bold mb-3">Sistema de Gestión de Rendimiento (SGR)</h1>
                    <p class="lead mb-3 text-white-50">
                        Conoce los compromisos, metas institucionales y ponderaciones de rendimiento que guían la labor de las delegaciones municipales de La Serena en beneficio de nuestra comunidad.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#metas-publicas" class="btn btn-light text-primary fw-bold">Ver Metas Comunitarias &darr;</a>
                        <a href="/catalogo-servicios" class="btn btn-outline-light">Servicios Municipales</a>
                    </div>
                </div>
                <div class="col-lg-4 mt-4 mt-lg-0 text-center">
                    <div class="bg-white text-dark p-3 rounded-3 shadow-sm text-start">
                        <div class="fw-bold text-primary mb-2">Ingreso Rápido de Prueba:</div>
                        <p class="small text-muted mb-2">Prueba el sistema con diferentes roles y delegaciones:</p>
                        <div class="d-grid gap-1">
                            <a href="/demo-login/admin" class="btn btn-sm btn-outline-primary text-start">
                                👑 <strong>Administrador</strong> (Ve todas las delegaciones y panel)
                            </a>
                            <a href="/demo-login/funcionario1" class="btn btn-sm btn-outline-info text-start">
                                👤 <strong>Funcionario Centro</strong> (Solo Delegación Centro)
                            </a>
                            <a href="/demo-login/delegado_companias" class="btn btn-sm btn-outline-warning text-start">
                                👤 <strong>Delegado Las Compañías</strong> (Solo Las Compañías)
                            </a>
                            <a href="/demo-login/funcionario_rural" class="btn btn-sm btn-outline-success text-start">
                                👤 <strong>Funcionario Rural</strong> (Solo Delegación Rural)
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Badges -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card stat-card bg-white p-3 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Delegaciones Activas</div>
                    <div class="fs-3 fw-bold text-primary mt-1">3 Delegaciones</div>
                    <small class="text-secondary">Centro, Las Compañías, Rural</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-white p-3 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Metas en Seguimiento</div>
                    <div class="fs-3 fw-bold text-success mt-1"><%= totalMetasCount %> Metas</div>
                    <small class="text-secondary">Con evidencia y ponderación</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-white p-3 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Período de Evaluación</div>
                    <div class="fs-3 fw-bold text-dark mt-1">2026</div>
                    <small class="text-secondary">240 Días Computables</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card bg-white p-3 h-100">
                    <div class="text-muted small fw-semibold text-uppercase">Marco Legal y Normativo</div>
                    <div class="fs-3 fw-bold text-info mt-1">Ley 19.803</div>
                    <small class="text-secondary">Metas de Gestión Municipal</small>
                </div>
            </div>
        </div>

        <!-- Delegaciones Presentation -->
        <h4 class="fw-bold text-primary mb-3">Delegaciones Municipales Participantes</h4>
        <div class="row g-3 mb-5">
            <% delegaciones.forEach(d => { %>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0"><%= d.nombre %></h5>
                                <% if (d.activa) { %>
                                    <span class="badge bg-success">Activa</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactiva</span>
                                <% } %>
                            </div>
                            <p class="card-text text-muted small mt-2">
                                Atiende y gestiona las solicitudes ciudadanas, operativos territoriales y cumplimiento de metas del sector.
                            </p>
                            <a href="?delegacion=<%= d.id %>#metas-publicas" class="btn btn-sm btn-outline-primary">Ver metas de esta delegación &rarr;</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Public Metas Table -->
        <div id="metas-publicas" class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-primary mb-0">Consulta Ciudadana de Metas y Compromisos</h4>
                <p class="text-muted small mb-0">Registro público transparente de metas asignadas por delegación.</p>
            </div>
            <a href="/login" class="btn btn-outline-primary btn-sm fw-bold">Área Exclusiva Funcionarios &rarr;</a>
        </div>

        <!-- Filter bar -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2 px-3">
                <form method="get" action="/wireframe-front" class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <input type="text" name="q" class="form-control form-control-sm" placeholder="Buscar por cargo o descripción..." value="<%= searchQuery || '' %>">
                    </div>
                    <div class="col-md-3">
                        <select name="delegacion" class="form-select form-select-sm">
                            <option value="">Todas las Delegaciones</option>
                            <% delegaciones.forEach(d => { %>
                                <option value="<%= d.id %>" <%= (selectedDelegacion == d.id) ? 'selected' : '' %>><%= d.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="periodo" class="form-select form-select-sm">
                            <option value="">Todos los Períodos</option>
                            <% periodos.forEach(p => { %>
                                <option value="<%= p.id %>" <%= (selectedPeriodo == p.id) ? 'selected' : '' %>><%= p.label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex">
                        <button type="submit" class="btn btn-sm btn-primary w-100 me-1">Filtrar</button>
                        <a href="/wireframe-front" class="btn btn-sm btn-outline-secondary" title="Limpiar">✕</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cargo / Responsable</th>
                            <th>Delegación</th>
                            <th>Período</th>
                            <th>Ponderación</th>
                            <th>Compromiso Institucional</th>
                            <th class="text-end pe-4">Evidencia Pública</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (page_obj && page_obj.metas && page_obj.metas.length > 0) { %>
                            <% page_obj.metas.forEach(meta => { %>
                            <tr>
                                <td>
                                    <strong><%= meta.cargo_o_usuario %></strong>
                                </td>
                                <td>
                                    <span class="badge text-bg-light border text-secondary"><%= meta.delegacionNombre %></span>
                                </td>
                                <td><small class="text-muted"><%= meta.periodoLabel %></small></td>
                                <td><span class="badge bg-primary fs-6"><%= meta.ponderacion %>%</span></td>
                                <td>
                                    <div class="text-secondary small" style="max-width: 380px;">
                                        <%= meta.descripcion %>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <% if (meta.evidencia) { %>
                                        <button type="button" class="btn btn-sm btn-outline-info js-preview-img" data-src="<%= meta.evidencia %>" data-title="<%= meta.cargo_o_usuario %>">
                                            🔍 Ver Documento
                                        </button>
                                    <% } else { %>
                                        <span class="text-muted small">Sin archivo adjunto</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No se encontraron metas para el filtro seleccionado.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Footer con paginador -->
            <% if (page_obj && page_obj.paginator && page_obj.paginator.num_pages > 1) { %>
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <span class="text-muted small">Total: <%= page_obj.paginator.count %> metas registradas</span>
                <nav aria-label="Paginación pública">
                    <ul class="pagination pagination-sm mb-0">
                        <% if (page_obj.has_previous) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= page_obj.previous_page_number %>&delegacion=<%= selectedDelegacion %>&periodo=<%= selectedPeriodo %>&q=<%= searchQuery %>#metas-publicas">Anterior</a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled"><span class="page-link">Anterior</span></li>
                        <% } %>

                        <li class="page-item active"><span class="page-link"><%= page_obj.number %> / <%= page_obj.paginator.num_pages %></span></li>

                        <% if (page_obj.has_next) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= page_obj.next_page_number %>&delegacion=<%= selectedDelegacion %>&periodo=<%= selectedPeriodo %>&q=<%= searchQuery %>#metas-publicas">Siguiente</a>
                            </li>
                        <% } else { %>
                            <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
                        <% } %>
                    </ul>
                </nav>
            </div>
            <% } %>
        </div>

        <!-- Footer Notice -->
        <div class="text-center text-muted small mt-5 pt-3 border-top">
            <p class="mb-1">Ilustre Municipalidad de La Serena &bull; Sistema de Gestión de Rendimiento (SGR)</p>
            <p class="mb-0">Para funcionarios y delegados: <a href="/login" class="text-decoration-none">Iniciar sesión en el panel institucional</a></p>
        </div>
    </div>

    <!-- Modal Previsualización de Evidencia -->
    <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="previewModalTitle">Evidencia Adjunta</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center p-3 bg-light">
                    <img id="previewModalImg" src="" alt="Evidencia" class="img-fluid rounded shadow-sm border" style="max-height: 500px; object-fit: contain;">
                </div>
                <div class="modal-footer">
                    <a id="previewModalLink" href="" target="_blank" class="btn btn-sm btn-outline-primary">Abrir en pestaña nueva</a>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll(".js-preview-img").forEach(btn => {
            btn.addEventListener("click", function () {
                const src = this.getAttribute("data-src");
                const title = this.getAttribute("data-title");
                document.getElementById("previewModalImg").src = src;
                document.getElementById("previewModalLink").href = src;
                document.getElementById("previewModalTitle").textContent = "Evidencia: " + title;
                const modal = new bootstrap.Modal(document.getElementById("previewModal"));
                modal.show();
            });
        });
    </script>
</body>
</html>
